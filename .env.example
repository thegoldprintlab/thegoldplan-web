VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Billing (Fasa B) -------------------------------------------------
# Enable premium gating. Leave unset/false to keep the app fully open (current default).
VITE_BILLING_ENABLED=false

# Stripe publishable key (pk_...) — public, safe to expose in the bundle.
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Payment Links (create in Stripe Dashboard → Payments → Payment links).
# The app appends ?prefilled_email=...&client_reference_id=<user-uuid> automatically.
VITE_STRIPE_LINK_MONTHLY=
VITE_STRIPE_LINK_LIFETIME=

# --- Analytics (GA4) --------------------------------------------------
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# Leave BLANK to disable analytics entirely — no script, no network calls.
# Only loaded in production builds, never in `npm run dev`.
VITE_GA_ID=

# --- Error tracking (Sentry) ------------------------------------------
# DSN from Sentry → Project Settings → Client Keys (DSN).
# Leave BLANK to disable error reporting entirely.
VITE_SENTRY_DSN=
# Optional label shown in Sentry (e.g. production, preview).
VITE_SENTRY_ENV=
# Release tag for source-map matching — set to the git SHA at build time.
VITE_APP_VERSION=

# Build-time only (never exposed to the browser bundle).
# Sentry auth token for uploading source maps. Set in Vercel, NOT in .env files.
# Without it, stack traces stay minified but the build still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
